# Copiar para .env e preencher. O .env NÃO é versionado; este ficheiro É.
# NUNCA escrever valores reais aqui.

# ActivityInfo — token da API
ACTIVITYINFO_TOKEN=

# ActivityInfo — ID do formulário de gestão de casos.
# Fora do código por apontar directamente para os dados da organização.
ACTIVITYINFO_FORM_ID=

# Supabase — botão "Connect" no topo do painel > separador "Session pooler" > copiar o URI.
# NÃO usar a ligação directa (db.<ref>.supabase.co): é IPv6 e o GitHub Actions é IPv4.
# Formato: postgresql://postgres.<project-ref>:SENHA@aws-<regiao>.pooler.supabase.com:5432/postgres
# Se a senha tiver símbolos, é preciso codificá-los:  @ = %40   # = %23   / = %2F   : = %3A   ? = %3F
DATABASE_URL=

# Sal para pseudonimizar nomes de gestores de casos.
# Qualquer texto longo e aleatório. Manter estável: se mudar, os identificadores mudam.
PSEUDONYM_SALT=
